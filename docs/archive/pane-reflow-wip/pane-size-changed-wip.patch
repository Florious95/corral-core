+// fanoutPaneReflow tells every other subscriber of ref that the shared pane
+// changed size, then pushes the same snapshot so their grid can rebuild.
+// The originating connection already received its snapshot and is skipped.
+func (s *Server) fanoutPaneReflow(except *wsConn, ref string, rows, cols uint16, snap []byte) {
+	body, err := protocol.MarshalFrame(protocol.PaneSizeChanged{Ref: ref, Rows: rows, Cols: cols})
+	if err != nil {
+		s.log.Error("resize: marshal pane_size_changed", "err", err)
+		return
+	}
+	s.trackersMu.Lock()
+	defer s.trackersMu.Unlock()
+	for c := range s.trackers {
+		if c == except || !c.subscribed(ref) {
+			continue
+		}
+		select {
+		case c.sendCh <- wsMsg{typ: wsText, data: body}:
+		default:
+			s.log.Debug("resize: dropping pane_size_changed for slow connection")
+		}
+		if len(snap) == 0 {
+			continue
+		}
+		select {
+		case c.sendCh <- wsMsg{typ: wsBinary, data: snap}:
+		default:
+			s.log.Debug("resize: dropping peer snapshot for slow connection")
+		}
+	}
+}
+
