+func (p PaneSizeChanged) Validate() error {
+	if p.Ref == "" {
+		return fmt.Errorf("%w: pane_size_changed ref must be non-empty", ErrInvalidField)
+	}
+	if p.Rows == 0 || p.Cols == 0 {
+		return fmt.Errorf("%w: pane_size_changed rows/cols must be >= 1", ErrInvalidField)
+	}
+	return nil
