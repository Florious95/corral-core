+
+func TestPaneSizeChangedIsServerToClientOnly(t *testing.T) {
+	raw := []byte(`{"v":1,"type":"pane_size_changed","payload":{"ref":"s1","rows":24,"cols":80}}`)
+	if _, err := protocol.UnmarshalFrame(raw); !errors.Is(err, protocol.ErrUnknownType) {
+		t.Fatalf("pane_size_changed must be server-to-client only; got err=%v", err)
+	}
+}
+
+func TestPaneSizeChangedMarshal(t *testing.T) {
+	frame := protocol.PaneSizeChanged{Ref: "s1", Rows: 24, Cols: 80}
+	data, err := protocol.MarshalFrame(frame)
+	if err != nil {
+		t.Fatalf("MarshalFrame: %v", err)
+	}
+	var env struct {
+		V       int             `json:"v"`
+		Type    string          `json:"type"`
+		Payload json.RawMessage `json:"payload"`
+	}
+	if err := json.Unmarshal(data, &env); err != nil {
+		t.Fatalf("unmarshal envelope: %v", err)
+	}
+	if env.Type != "pane_size_changed" {
+		t.Errorf("type = %q, want %q", env.Type, "pane_size_changed")
+	}
+	var p protocol.PaneSizeChanged
+	if err := json.Unmarshal(env.Payload, &p); err != nil {
+		t.Fatalf("unmarshal payload: %v", err)
+	}
+	if p.Ref != "s1" || p.Rows != 24 || p.Cols != 80 {
+		t.Errorf("payload = %+v", p)
+	}
+}
