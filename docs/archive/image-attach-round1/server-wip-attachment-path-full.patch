+
+// PaneSizeChanged notifies other live subscribers that the shared tmux pane
+// was resized (S→C). Clients apply the new grid locally and must not echo a
+// resize frame, or phone and web will fight. No ack.
+//
+// @contract
+// @pre Ref 非空，Rows/Cols >= 1
+// @post 对端把本地终端改成同一行列；不上行 resize
+// @err Validate 对空 Ref / 零尺寸返回 ErrInvalidField
+// @inv 只在 pane 实际几何变化后发送
+type PaneSizeChanged struct {
+	Ref  string `json:"ref"`
+	Rows uint16 `json:"rows"`
+	Cols uint16 `json:"cols"`
+}
