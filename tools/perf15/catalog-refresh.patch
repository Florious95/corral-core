+					select {
+					case <-release:
+					case <-c.ctx.Done():
+					}
+				})
+			}
+		}
+		c.writeAttempt = func(m wsMsg) {
+			if m.level2Epoch != 0 {
+				writes <- m.level2Epoch
+			}
+		}
+	})
+	defer func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	}()
+	other.sendFrame(&protocol.Level2Subscribe{Workspace: "/ws/a"})
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("L2 writer gate absent")
+	}
+	old := c.currentLevel2Epoch()
+	other.sendFrame(&protocol.Level2Subscribe{Workspace: "/ws/b"})
+	other.sendFrame(&protocol.Level2Unsubscribe{})
+	other.sendFrame(&protocol.Level2Subscribe{Workspace: "/ws/b"})
+	catalogEventually(t, "reader did not reach final epoch", func() bool { return c.currentLevel2Epoch() == old+3 })
+	e.srv.snapMu.RLock()
+	projection := e.srv.level2Projection
+	e.srv.snapMu.RUnlock()
+	if frame, _ := c.level2Output(old, projection, nil); frame != nil {
+		t.Fatal("stale completion admitted")
+	}
+	close(release)
+	frame := waitLevel2Frame(t, other, 3*time.Second)
+	if frame.Workspace != "/ws/b" {
+		t.Fatalf("queued old workspace leaked: %s", frame.Workspace)
+	}
+	select {
+	case epoch := <-writes:
+		if epoch != old+3 {
+			t.Fatalf("old epoch wrote: %d current=%d", epoch, old+3)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("final epoch never wrote")
+	}
+}
