+					default:
+					}
+				}
+			}
+			for _, sessions := range s.level2Projection {
+				for _, sess := range sessions {
+					if got, ok := snap.byRef[sess.Ref]; !ok || got != sess {
+						select {
+						case bad <- "mixed L2 publication generation":
+						default:
+						}
+					}
+				}
+			}
+			if len(entries) != len(snap.byRef) {
+				select {
+				case bad <- "mixed ref set":
+				default:
+				}
+			}
+			s.snapMu.RUnlock()
+		}
+	}()
+	for i := 0; i < 20; i++ {
