+	go func() {
+		defer close(joined)
+		for {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			s.snapMu.RLock()
+			snap, n, generation := s.snapshot, s.seq, s.scanGeneration
+			entries := s.catalog.list()
+			if snap == nil || n == 0 || generation == 0 {
+				select {
+				case bad <- "missing publication component":
+				default:
+				}
+			}
