<!--
  AgentMirror App 应用清单（骨架版）。
  MainActivity 为 Compose 单 Activity 入口；前台服务（fg-service 任务）与扫描配对等能力
  由后续任务补充。前台服务类型 dataSync（fg-service 知识基底 §1：Android 14+ 必声）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务 + 通知：状态沿变化发系统通知、常驻通知栏（fg-service）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentMirror">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          常驻连接前台服务（fg-service 任务）。startForeground 类型 dataSync：
          Android 14+ 启动前台服务需对应权限（FOREGROUND_SERVICE_DATA_SYNC）。
          onStartCommand START_STICKY：系统杀后重建，冷启动重连即恢复（004 无状态免疫）。
        -->
        <service
            android:name=".service.MirrorForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
