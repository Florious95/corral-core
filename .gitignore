# 依赖与系统
node_modules/
.DS_Store

# 团队编排运行时（含 profile 凭据，绝不入库）
.team/runtime/
.team/logs/
.team/current/profiles/*.env

# 构建产物
app/.gradle/
app/app/build/
app/build/
app/terminal/build/
**/build/
__pycache__/
*.pyc

# 编译二进制
server/agentmirrord
e2e/bin/agentmirrord

# e2e 取证目录里的构建残留：截图/日志/录屏留档，Gradle 缓存与构建输出不入库
# （2026-08-13：这两类曾被 9653be07f 整体入库，占 2.9 GB / 68093 个文件）
e2e/artifacts/**/gradle-home/
e2e/artifacts/**/gradle-build/

# Web 端生成物
web/vendor/
web/dist/

# ffmpeg 抽帧目录：由同目录 mp4 重出，不入库
# （2026-08-13：abc-regression 的 764 张已入库 112 MB，本次摘除跟踪）
e2e/artifacts/**/frames*/
